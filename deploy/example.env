# Copy to deploy/.env; fill locally, never commit. Use random hex MySQL passwords (DSN format).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
GRAFANA_PASSWORD=
# Optional Feishu override; FEISHU_ENABLED=true must be exported in shell.
FEISHU_WEBHOOK=
FEISHU_SECRET=
# Absolute path on Linux host; file holds a random 32+ byte bearer token.
ALERT_TOKEN_FILE=
